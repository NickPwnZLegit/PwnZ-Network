// REVIEW-ONLY: fail closed. PwnZ currently has no trusted, reservation-bound
// server upload intake or screening/approval worker. Do not deploy or enable.
// Candidate revision must be tested in Storage and Firestore emulators before
// ANY client-owned staging reads/writes are permitted.
rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /pwnzMediaStaging/{uid}/{uploadId}/source {
   allow create, get, list, update, delete: if false;
  }
  match /{other=**} {allow read,write: if false;}
 }
}
