rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function edenMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/edenRealIdOwners/$(request.auth.uid))
        && get(/databases/$(database)/documents/edenRealIdOwners/$(request.auth.uid)).data.uid == request.auth.uid
        && (
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('profileStatus','') == 'active'
          || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('edenRealIdStatus','') == 'activated_v16'
          || (
            get(/databases/$(database)/documents/edenRealIdOwners/$(request.auth.uid)).data.get('status','') == 'grandfathered'
            && get(/databases/$(database)/documents/edenRealIdOwners/$(request.auth.uid)).data.get('reservationType','') == 'legacy-profile-migration'
            && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('memberNumber',0) > 0
          )
        );
    }
    function edenAgreementCurrent() {
      return edenMember()
        && exists(/databases/$(database)/documents/agreements/$(request.auth.uid))
        && get(/databases/$(database)/documents/agreements/$(request.auth.uid)).data.get('accepted',false) == true
        && get(/databases/$(database)/documents/agreements/$(request.auth.uid)).data.get('agreementVersion','') == 'v16-2026.08.27.1'
        && get(/databases/$(database)/documents/agreements/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function pwnzAgreementCurrent() {
      return signedIn()
        && exists(/databases/$(database)/documents/pwnzAgreements/$(request.auth.uid))
        && get(/databases/$(database)/documents/pwnzAgreements/$(request.auth.uid)).data.accepted == true
        && get(/databases/$(database)/documents/pwnzAgreements/$(request.auth.uid)).data.version == 'pwnz-2026.10.30.1'
        && get(/databases/$(database)/documents/pwnzAgreements/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function agreementCurrent() {
      return signedIn() && (edenMember() ? edenAgreementCurrent() : pwnzAgreementCurrent());
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function profileExists(uid) { return exists(/databases/$(database)/documents/pwnzProfiles/$(uid)); }
    function profile(uid) { return get(/databases/$(database)/documents/pwnzProfiles/$(uid)).data; }
    function verifiedHandle(uid, handle) {
      return profileExists(uid) && profile(uid).handle == handle;
    }
    function textWithin(value, maximum) {
      return value is string && value.size() <= maximum;
    }
    function optionalVideoId(data) {
      return !('youtubeId' in data) || (data.youtubeId is string && data.youtubeId.matches('^[A-Za-z0-9_-]{11}$'));
    }
    function optionalTwitch(data) {
      return !('twitch' in data) || (data.twitch is string && data.twitch.matches('^[A-Za-z0-9_]{3,25}$'));
    }
    function publicPost(id) {
      return exists(/databases/$(database)/documents/pwnzPosts/$(id))
        && get(/databases/$(database)/documents/pwnzPosts/$(id)).data.status == 'published';
    }

    match /pwnzAgreements/{uid} {
      allow get: if owner(uid);
      allow list, delete: if false;
      allow create, update: if owner(uid) && !edenMember()
        && request.resource.data.keys().hasOnly(['uid','accepted','version','acceptedAt','expiresAt'])
        && request.resource.data.keys().hasAll(['uid','accepted','version','acceptedAt','expiresAt'])
        && request.resource.data.uid == uid
        && request.resource.data.accepted == true
        && request.resource.data.version == 'pwnz-2026.10.30.1'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31,'d');
    }

    match /pwnzHandles/{key} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if false; // Never expose the handle-to-UID registry as a directory.
      allow create: if agreementCurrent()
        && key.matches('^[a-z][a-z0-9_]{2,23}$')
        && request.resource.data.keys().hasOnly(['uid','handle','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z][a-z0-9_]{2,23}$')
        && request.resource.data.handle == key
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/pwnzProfiles/$(request.auth.uid)).data.handleKey == key;
      allow update, delete: if false;
    }

    match /pwnzProfiles/{uid} {
      // Identity-bearing records are owner-only, not a public UID directory.
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && agreementCurrent()
        && request.resource.data.keys().hasOnly(['uid','handle','handleKey','role','bio','twitch','youtube','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','handle','handleKey','role','bio','twitch','youtube','createdAt','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z][a-z0-9_]{2,23}$')
        && request.resource.data.handleKey == request.resource.data.handle
        && request.resource.data.role == 'member'
        && request.resource.data.bio == ''
        && request.resource.data.twitch == ''
        && request.resource.data.youtube == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/pwnzHandles/$(request.resource.data.handleKey)).data.uid == uid;
      allow update: if owner(uid) && agreementCurrent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio','twitch','youtube','updatedAt'])
        && textWithin(request.resource.data.bio, 300)
        && optionalTwitch(request.resource.data)
        && textWithin(request.resource.data.youtube, 2048)
        && (
          request.resource.data.youtube == '' ||
          request.resource.data.youtube.matches('^https://(www[.])?(youtube[.]com|youtu[.]be)/.*$')
        )
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /pwnzPosts/{postId} {
      allow read: if resource.data.status == 'published';
      allow create: if agreementCurrent()
        && verifiedHandle(request.auth.uid, request.resource.data.authorHandle)
        && request.resource.data.keys().hasOnly(['authorUid','authorHandle','title','body','youtubeId','twitch','status','createdAt'])
        && request.resource.data.keys().hasAll(['authorUid','authorHandle','title','body','status','createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && textWithin(request.resource.data.title, 140)
        && textWithin(request.resource.data.body, 4000)
        && (request.resource.data.title.size() > 0 || request.resource.data.body.size() > 0 || 'youtubeId' in request.resource.data || 'twitch' in request.resource.data)
        && optionalVideoId(request.resource.data)
        && optionalTwitch(request.resource.data)
        && request.resource.data.status == 'published'
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if agreementCurrent() && resource.data.authorUid == request.auth.uid;
    }

    match /pwnzComments/{commentId} {
      allow read: if publicPost(resource.data.postId) && resource.data.createdAt is timestamp;
      allow create: if agreementCurrent()
        && request.resource.data.keys().hasOnly(['postId','authorUid','authorHandle','body','createdAt'])
        && request.resource.data.keys().hasAll(['postId','authorUid','authorHandle','body','createdAt'])
        && request.resource.data.postId is string
        && publicPost(request.resource.data.postId)
        && request.resource.data.authorUid == request.auth.uid
        && verifiedHandle(request.auth.uid, request.resource.data.authorHandle)
        && textWithin(request.resource.data.body, 500)
        && request.resource.data.body.size() > 0
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Applications remain pending. Browser users cannot approve their own roles.
    match /pwnzRoleApplications/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && agreementCurrent()
        && profileExists(uid)
        && request.resource.data.keys().hasOnly(['uid','roleRequested','summary','exampleLink','rightsConfirmed','status','createdAt'])
        && request.resource.data.keys().hasAll(['uid','roleRequested','summary','exampleLink','rightsConfirmed','status','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.roleRequested in ['gamer','game_creator']
        && textWithin(request.resource.data.summary, 1200)
        && request.resource.data.summary.size() >= 20
        && textWithin(request.resource.data.exampleLink, 1024)
        && (request.resource.data.exampleLink == '' || request.resource.data.exampleLink.matches('^https://.*$'))
        && request.resource.data.rightsConfirmed is bool
        && (request.resource.data.roleRequested == 'gamer' || request.resource.data.rightsConfirmed == true)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Private hearts: one owner heart per post, no public UID listing.
    match /pwnzHearts/{id} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if agreementCurrent() && profileExists(request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid','postId','createdAt'])
        && request.resource.data.keys().hasAll(['uid','postId','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.matches('^[a-zA-Z0-9]{10,50}$')
        && id == request.resource.data.postId + '__' + request.auth.uid
        && publicPost(request.resource.data.postId)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /pwnzFollows/{id} {
      allow read: if signedIn() && (resource.data.followerUid == request.auth.uid || resource.data.followedUid == request.auth.uid);
      allow create: if agreementCurrent()
        && request.resource.data.keys().hasOnly(['followerUid','followedUid','createdAt'])
        && request.resource.data.keys().hasAll(['followerUid','followedUid','createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.followedUid is string
        && request.resource.data.followedUid != request.auth.uid
        && profileExists(request.resource.data.followedUid)
        && id == request.auth.uid + '__' + request.resource.data.followedUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
    }
  }
}
